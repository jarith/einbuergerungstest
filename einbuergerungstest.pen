    {
      "type": "frame",
      "id": "RvgbB",
      "x": 1540,
      "y": 2636,
      "name": "HOME / Legend interaction · hover and touch",
      "context": "Static interaction specification with illustrative data. Desktop/tablet hover Learning and mobile tap Learned examples; does not change learner values on the dashboard.",
      "theme": {
        "mode": "light"
      },
      "clip": true,
      "width": 1440,
      "fill": "$bg",
      "stroke": "$divider",
      "layout": "vertical",
      "gap": 16,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "qZrPM",
          "name": "Legend interaction heading",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Legend interaction · hover and touch",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 20,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "KJQSh",
          "name": "Pointer hover behavior",
          "fill": "$text-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Pointer / hover: entering a legend item highlights its matching pie slice. Keep that slice at full opacity and thicken it inward (inner-radius ratio 0.87 → 0.79); dim other slices to 35% opacity. Add the existing muted surface and a neutral outline to the active legend item. Do not change segment angles, data, center values or layout. Leaving the legend restores the default chart unless a clicked/tapped selection is active; hovering another item temporarily previews it and leaving restores that selection.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "d88vXI",
          "name": "Pointer click and touch behavior",
          "fill": "$text-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Mouse click, touch tap, or keyboard activation toggles a persistent highlight for the selected legend item. Activate a different item to switch; activate the selected item again or outside the chart and legend to clear. Hover or focus temporarily previews another status; leaving restores the selection. No hover is required on touch devices. Keep every legend item at least 44 × 44 px. Selection affects only the chart highlight and does not filter questions or change progress.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "Z7uit",
          "name": "Keyboard and zero-count behavior",
          "fill": "$text-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Keyboard: legend items are buttons in status order. Focus previews the corresponding slice and shows the existing focus ring; Enter/Space toggles selection, Escape clears it, and focus remains in place. Expose each status name, exact count, whole percentage and pressed state. For a zero-count item, highlight its legend item and announce the zero count, but keep the chart unchanged—never invent a slice. Highlight changes are immediate and require no animation. These are static interaction specifications, not tested runtime behavior.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "Vk738",
          "name": "Interaction example data",
          "fill": "$text-muted",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Illustrative interaction examples only: 80 Not started, 40 Needs review, 70 Learning and 120 Learned (310 total, 190 contributing = 61%). The dashboard retains its existing learner example.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "I8FXg6",
          "name": "Pointer and touch interaction examples",
          "width": "fill_container",
          "gap": 48,
          "justifyContent": "center",
          "children": [
