        {
          "type": "text",
          "id": "L59h8",
          "name": "Behavior and accessibility heading",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Behavior to preserve",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 20,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "S8wTAg",
          "name": "Reading and action behavior",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Reading and focus order: global navigation → Study all questions → Start mock test → Edit date → groups in their original order. Each group action opens the existing group route and keeps the saved position. Its accessible name includes the group title.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "BbPiL",
          "name": "Progress behavior",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Use the exact contributing count beside the percentage; the denominator also gives the group question count. Calculate the fill from the exact fraction. Use one decimal between 0–1% and 99–100% (for example 1/310 = 0.3%); use whole percentages otherwise. Show 100% only when every question contributes. Zero alone does not mean a new group.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "s7BXgT",
          "name": "First use behavior",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "First use: show 0 / 310 contributing · 0%, empty bars and Study group actions. No saved position: Study group. Active position: Continue group plus Continue at question {position} of {total}, using the saved one-based group position independently of progress. Completed pass: View completed group, even below 100%; no resume hint.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "G9ZZO",
          "name": "Responsive behavior",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Desktop: group, progress and action columns. Tablet: group beside progress and action. Mobile: title and full description, then progress beside a compact 48 px study action; resume hint immediately below. Stack progress and action when longer localized labels cannot fit. Long titles and descriptions wrap without truncation. Bottom navigation stays fixed above the safe area; page content reserves its height.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "XJdaS",
          "name": "Focus and loading behavior",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Actions have 48 px targets. Retain a visible focus ring in both themes; do not move focus when progress updates. Loading or unreadable local data follows the existing startup/recovery flow rather than displaying false zero progress. Date examples use Oct 3, 2026 with a planned test on Oct 8.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
