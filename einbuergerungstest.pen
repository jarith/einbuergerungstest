          "width": "fill_container",
          "content": "Interaction and recovery",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 20,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "rBsgS",
          "name": "Download behavior",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Includes all 14 groups, whether open or closed, in the Settings language (EN, DE or RU). Retain German study vocabulary, source order and the notes’ edition date. No language dialog, account step or confirmation.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "qeOvA",
          "name": "Progress and failure behavior",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Show preparation only when needed; no artificial delay or progress percentage. Keep the notes usable and retain open drawers, scroll and focus. Announce preparation and completion politely; announce failure once. After 15 seconds, show “This is taking longer than expected. You can keep reading.” After 60 seconds, end the attempt and offer Try again; a timed-out attempt must not trigger a late duplicate download.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "dGqwQ",
          "name": "PDF output scope",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Use locally available notes so download remains available once offline preparation is complete. The PDF contains the full readable notes, not a screenshot of closed drawers or app navigation. Preserve selectable text and German/Cyrillic glyphs. Use a print-friendly light page regardless of app theme. Suggested filename: einbuergerungstest-berlin-cheat-sheet-en.pdf, with the current language code.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "OtWUq",
          "name": "Browser completion scope",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "“PDF ready” confirms preparation and browser handoff only. The browser may download or open its PDF viewer; do not claim “Saved”. Keep completion and failure feedback inline, with repeat download or retry available.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 16,
          "fontWeight": "normal"
        },
