    },
    {
      "type": "frame",
      "id": "ldHVB",
      "x": 0,
      "y": 5690,
      "name": "PROGRESS / Grouped questions · States and behavior",
      "theme": {
        "mode": "light"
      },
      "width": 1440,
      "fill": "$bg",
      "layout": "vertical",
      "gap": 24,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "MIokh",
          "name": "Board heading",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Progress · groups, filters and tabs",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 28,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "c1Wfxc",
          "name": "Specimen data",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Design examples use real question-bank groups and question order. All / Needs review: 307 Not started + 2 Needs review + 1 Learning. Learned example: a later illustrative profile with 287 Not started + 23 Learned (12 + 11 in the first two groups). Empty example: first use, all 310 Not started.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "GR9gN",
          "name": "Reading and navigation heading",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Reading and navigation",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 18,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "QK8hk",
          "name": "Reading and navigation",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Progress heading → tab list → active panel. Only Question status or Mock tests is visible at a time. Default: Question status. Preserve each tab’s state when switching. Question rows open their existing history detail; returning restores the group, filter, revealed count and scroll position.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "Cigir",
          "name": "Group disclosure heading",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Group disclosure",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 18,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "VOKuO",
          "name": "Group disclosure",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Keep all 13 groups in question-bank order. Multiple groups may be expanded together; the first two are open in the main specimen to show independent lists. Each group is one enclosed surface with an 8 px radius, separated from adjacent groups by 16 px of page background. Use surface-muted for the full disclosure header, 16 px inset padding and no separator stroke. Expanded content continues in surface beneath the header; remove the nested question-list outline. Group headings are buttons with expanded state and a named controlled panel. The entire header is the toggle target; Enter or Space toggles only that group. Keep focus on the header and retain the revealed count while collapsed. Hover uses state-pressed on the header; keyboard focus uses the existing 2 px focus ring around the entire header. Chevron orientation also communicates open or closed state.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "DDYB2",
          "name": "Global filtering heading",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Global filtering",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 18,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "Xa454",
          "name": "Global filtering",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "One selected filter applies to every group. Filter buttons always show totals across all 310 questions, independent of opened groups and visible rows. A group shows its own matching count. Keep groups with zero matches visible and show an inline empty message when opened. Group status bars always describe all questions in that group.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "mXfOI",
          "name": "Independent pagination heading",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Independent pagination",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 18,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "OlV0U",
          "name": "Independent pagination",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Initially show up to 10 matching questions per group in bank order. Show next 10 questions appends only to that group. After loading 10 more: Showing 20 of 27 questions; other groups remain at their previous counts. On the final batch show all remaining matches and remove the button. A filter change resets every group’s visible limit to 10.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "t7JVR",
          "name": "Keyboard and announcements heading",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Keyboard and announcements",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 18,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "bNpgj",
          "name": "Keyboard and announcements",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Tabs: Left/Right and Home/End select a tab; Tab enters the active panel. Filters expose selected state and bank-wide counts. Preserve focus on filter changes and announce matching totals. After append, move focus to the first appended question so users can reach it without tabbing backward; announce the group name and visible count. Visible focus uses the existing focus-ring token, 2 px outline with clear offset.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "Ls8M9",
          "name": "Responsive structure heading",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Responsive structure",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 18,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "PgSbc",
          "name": "Responsive structure",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
