    {
      "type": "frame",
      "id": "danC8",
      "x": 1540,
      "y": 5690,
      "name": "CHEAT SHEET / 23 Interaction, localization and content specification",
      "theme": {
        "mode": "light"
      },
      "clip": true,
      "width": 1440,
      "fill": "$bg",
      "layout": "vertical",
      "gap": 32,
      "padding": 48,
      "children": [
        {
          "type": "text",
          "id": "NBqbT",
          "name": "Specification title",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Cheat sheet · design specification",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 32,
          "fontWeight": "700"
        },
        {
          "type": "frame",
          "id": "Qd0yu",
          "name": "One page, 14 independent drawers",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "Q7KmRh",
              "name": "Specification heading",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "One page, 14 independent drawers",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "bmgUt",
              "name": "Specification detail",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Add a Cheat sheet destination before Settings. Keep the source document’s 14 groups in order; these are the notes’ groups, independent of the question-bank grouping. All drawers start closed. Opening a drawer reveals its entire content inline and leaves other open drawers unchanged. The all-expanded artboard shows the complete content of this same page, not 14 routes. Each expanded group ends with a Close group button, so readers do not need to scroll back through its notes to collapse it.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "l1ftj",
          "name": "Language follows Settings",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "dduRk",
              "name": "Specification heading",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Language follows Settings",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "fIH6b",
              "name": "Specification detail",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "All mockups use English. In the app, use the saved English, Russian or German UI language for the page title, navigation, group titles, subheadings, prose, Close group controls and dates. Retain German exam vocabulary and proper names in the explanations. No separate language picker or study-translation toggle. Switching language updates content without closing drawers; preserve group IDs and the current reading position.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "wvSrm",
          "name": "Reading and responsive layout",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "yt1sj",
              "name": "Specification heading",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Reading and responsive layout",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "SyFPL",
              "name": "Specification detail",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Fill the available page width like Progress. Desktop: 236 px sidebar, 46 px side gutters; no centered page-width cap. Tablet: top navigation and 36 px gutters. Mobile: 20 px gutters and bottom navigation with safe-area clearance. Headers and group surfaces stretch; expanded prose uses at most 760 px and shrinks to fit. Keep one reading column and normal page scrolling, with no nested scroll or fixed-height bodies. Desktop notes align with the group title; tablet/mobile use 16 px body insets. Group numbers retain a 24 px column. Match Progress accordions: 16 px gaps, surface-muted headers with 16 px padding, 8 px corners, and surface bodies without an extra outline. Titles wrap at 18 px; body text stays 16 px at 1.6 line height. Hover changes only the header; focus uses the existing ring. Full-scroll artboards expose all content; app navigation remains fixed.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "qgGEx",
          "name": "Keyboard and accessibility",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "wCkwR",
              "name": "Specification heading",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Keyboard and accessibility",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "Abb3L",
              "name": "Specification detail",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Use one h1 and a button within each h2. Expose aria-expanded and aria-controls, with a labelled content region. Tab follows reading order; Enter or Space toggles a drawer. Focus stays on its header. Collapsed content is removed from the focus and accessibility trees. No modal focus trap. Preserve a visible 2 px focus ring; the whole header is a touch target of at least 44 px. Mark German vocabulary with lang=de. Closing from the end of a drawer restores focus to its heading and reveals that heading with nearest scroll alignment. The accessible name identifies the group being closed.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "KdLwt",
          "name": "Content and source fidelity",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "KyDGO",
              "name": "Specification heading",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Content and source fidelity",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "blwru",
              "name": "Specification detail",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "All 14 groups and their source subheadings are included in the expanded content artboard. The English text is a translation of the supplied notes, dated 26 September 2026, not a factual update. The source heading says 310 facts, but its list contains fewer entries; this design therefore displays 14 groups rather than a fact count. Berlin is the Berlin-specific group, not another settings choice.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "RDiPD",
          "name": "States and scope",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "A3slak",
              "name": "Specification heading",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "States and scope",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "GIdfh",
              "name": "Specification detail",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Default: all groups collapsed. Reading: one or several groups open. Full-content reference: all groups expanded. The mobile Berlin view is a scrolled position of the same page. Notes are bundled and available offline once prepared. Download PDF above the drawers saves all 14 groups in the Settings language. See CHEAT SHEET / 24 for preparation, browser handoff, retry, accessibility and responsive behavior. Honour the existing light/dark tokens. Reduced motion uses immediate expand/collapse.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "qi6bh",
          "name": "Design review checklist",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "g9hhs",
              "name": "Specification heading",
              "fill": "$text",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Design review checklist",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "bILrY",
              "name": "Specification detail",
              "fill": "$text",
