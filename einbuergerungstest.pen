              "width": "fill_container",
              "gap": 8,
              "children": [
                {
                  "type": "frame",
                  "id": "HhHPb",
                  "name": "Filter Falsch",
                  "height": 44,
                  "fill": "$surface",
                  "cornerRadius": "$radius-control",
                  "stroke": "$border",
                  "strokeWidth": 1,
                  "padding": [
                    0,
