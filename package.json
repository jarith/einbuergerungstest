{
  "name": "web-app-template",
  "private": true,
  "workspaces": [
    "web",
    "e2e",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "yarn workspace @einbuergerungstest/web dev",
    "build": "yarn workspaces foreach -Apt run build",
    "lint": "yarn panda:prepare && yarn lint:workflows && yarn lint:ast-grep && yarn lint:smithers && yarn workspaces foreach -Apt run lint",
    "lint:workflows": "actionlint",
    "lint:ast-grep": "yarn run -T ast-grep scan --color always --format github -c sgconfig.yml --no-ignore hidden --globs '!packages/lint-rules/src/**/fixtures/**' web e2e packages",
    "lint:smithers": "sh -c 'test ! -d .smithers || node --experimental-strip-types .smithers/automation/check.ts lint'",
    "ts:compile": "yarn workspaces foreach -At run ts:compile && sh -c 'test ! -d .smithers || yarn run -T tsc -p .smithers/tsconfig.json'",
    "format": "yarn workspaces foreach -Aptv run format && yarn oxfmt -c .oxfmtrc.json --write --no-error-on-unmatched-pattern docs oxlint.config.ts && sh -c 'test ! -d .smithers || node --experimental-strip-types .smithers/automation/check.ts format'",
    "format:check": "yarn workspaces foreach -Aptv run format:check && yarn oxfmt -c .oxfmtrc.json --check --no-error-on-unmatched-pattern docs oxlint.config.ts && sh -c 'test ! -d .smithers || node --experimental-strip-types .smithers/automation/check.ts format:check'",
    "create:package": "yarn workspace @einbuergerungstest/create-package-cli create:package",
    "panda:prepare": "yarn workspace @einbuergerungstest/design-system panda:prepare",
    "test": "yarn workspaces foreach -Apt run test",
    "test:browser": "yarn workspaces foreach -Apt run test:browser",
    "test:e2e": "yarn workspace @einbuergerungstest/e2e test:e2e",
    "test:storybook": "yarn workspace @einbuergerungstest/design-system test:storybook",
    "storybook": "yarn workspace @einbuergerungstest/design-system storybook",
    "browser:install": "yarn workspace @einbuergerungstest/e2e browser:install"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@mantine/core": "9.6.3",
    "@mantine/hooks": "9.6.3",
    "@reatom/core": "1001.3.0",
    "@reatom/react": "1001.0.1",
    "i18next": "26.4.2",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@axe-core/playwright": "4.13.0",
    "@oxlint/plugins": "1.86.0",
    "@pandacss/dev": "2.0.0",
    "@pandacss/eslint-plugin": "2.0.0",
    "@pandacss/preset-base": "2.0.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/eslint": "9.6.1",
    "@types/estree": "1.0.9",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.3",
    "axe-core": "4.13.0",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "eslint-plugin-storybook": "10.6.1",
    "jiti": "2.7.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "1.63.0",
    "playwright-bdd": "9.2.1",
    "playwright-core": "1.63.0",
    "postcss": "8.5.28",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "storybook": "10.6.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0"
  }
}
