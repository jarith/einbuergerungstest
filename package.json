{
  "name": "web-app-template",
  "private": true,
  "workspaces": [
    "web",
    "e2e",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "yarn workspace @app/web dev",
    "build": "yarn workspaces foreach -Apt run build",
    "lint": "yarn lint:actions && yarn panda:prepare && yarn workspaces foreach -Apt run lint",
    "lint:actions": "github-actionlint -shellcheck= -pyflakes=",
    "ts:compile": "yarn workspaces foreach -At run ts:compile",
    "format": "yarn workspaces foreach -Aptv run format && yarn oxfmt -c .oxfmtrc.json --write --no-error-on-unmatched-pattern docs",
    "format:check": "yarn workspaces foreach -Aptv run format:check && yarn oxfmt -c .oxfmtrc.json --check --no-error-on-unmatched-pattern docs",
    "create:package": "yarn workspace @app/create-package-cli create:package",
    "panda:prepare": "yarn workspace @app/design-system panda:prepare",
    "test": "yarn workspaces foreach -Apt run test",
    "test:browser": "yarn workspaces foreach -Apt run test:browser",
    "test:e2e": "yarn workspace @app/e2e test:e2e",
    "test:storybook": "yarn workspace @app/design-system test:storybook",
    "storybook": "yarn workspace @app/design-system storybook",
    "browser:install": "yarn workspace @app/e2e browser:install"
  },
  "dependencies": {
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@reatom/core": "1001.3.0",
    "@reatom/react": "1001.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@oxlint/plugins": "1.83.0",
    "@pandacss/dev": "1.12.1",
    "@pandacss/preset-base": "1.12.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/eslint": "9.6.1",
    "@types/estree": "1.0.9",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.1",
    "axe-core": "4.13.0",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "github-actionlint": "1.7.12",
    "jiti": "2.7.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "playwright": "1.63.0",
    "playwright-bdd": "9.2.1",
    "playwright-core": "1.63.0",
    "postcss": "8.5.28",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "storybook": "10.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vitest-browser-react": "2.3.0"
  },
  "packageManager": "yarn@4.18.0"
}
