{
  "name": "@app/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "yarn panda:prepare && yarn dev:serve",
    "dev:serve": "yarn run -T vite --host 127.0.0.1",
    "ts:compile": "yarn run -T tsc -p tsconfig.json",
    "lint": "yarn run -T oxlint .",
    "format:check": "yarn run -T oxfmt --check .",
    "panda:prepare": "yarn workspace @app/design-system panda:prepare",
    "build": "yarn panda:prepare && yarn run -T vite build",
    "preview": "yarn run -T vite preview --host 127.0.0.1",
    "test:browser": "yarn panda:prepare && yarn run -T vitest run --config vitest.browser.config.ts"
  }
}
