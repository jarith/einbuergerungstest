# Revalidate network responses, including extensionless learner URLs. Offline
# availability is managed by the service worker's versioned precache.
/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'none'; script-src 'self' https://cloud.umami.is/script.js; connect-src 'self' https://gateway.umami.is; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/sw.js
  Content-Type: application/javascript; charset=utf-8

/pwa/sw.js
  Content-Type: application/javascript; charset=utf-8

/pwa/offline-check.js
  Content-Type: application/javascript; charset=utf-8

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

# A production artifact is also available at Cloudflare's deployment aliases.
# Never apply these indexing headers to the custom domain.
https://:project.pages.dev/*
  X-Robots-Tag: noindex, follow

https://:deployment.:project.pages.dev/*
  X-Robots-Tag: noindex, follow
